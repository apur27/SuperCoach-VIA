  "decisions": {
    "blank_evidence": "six source states + NOT_APPLICABLE_DNTF; blank team Totals = not recorded; non-blank Totals + blank cell = zero; all-zero column unresolved until proven; pre-1965 from match structure; %P never zero-filled; repo 'modern blank = zero' convention not adopted",
    "cli_contracts": "scvia reconcile-afltables plan|capture|compare per DESIGN §11 as a Typer sub-app; exits 0/2/4/5/8/9 reuse cli.EXIT; plan/compare network-denied; capture --resume with unchanged plan",
    "completeness_accounting": "census closure identity; exhaustive exclusive appearance/cell/aggregate partitions (aggregate incl. source-unavailable and not-applicable); recorded-zero and malformed sub-counts; DNTF not-applicable; duplicates/conflicts orthogonal; failed census = unknown denominator; five separate completeness fields",
    "harness_scope": "opt-in audit, not wired to schedule/hook/gate; additive http.py field only shared-code change; byte-identical default proven by test means CLAUDE.md §6.2 test 2 not triggered; Scientist records the determination; any behaviour change requires scratch smoke run",
    "identity_fallback": "verified source URL > evidenced override > unique name+full DOB+membership > unique full DOB + identical season-club set (3b) > globally unique exact appearance-set equality when DOB missing/low precision (4) > UNKNOWN; no fuzzy authorisation; no name-built URLs; global uniqueness",
    "performance_targets": "offline full compare <=10 min and <=2 GiB peak process-tree RSS at 4 workers; warm <=2 min; fast tier +<=10 s; acquisition measured separately (estimate >=17 h); missed targets stay open; smaller cache permitted if targets met",
    "scope": "Men's senior VFL/AFL premiership 1897 through --through-date 2026-09-30 incl. finals, drawn finals, replays; all supported statistics incl. pre-1984 season-only Brownlow (SOURCE_SUMMARY_ONLY); exclusion is an owner choice to be named in attestation; _gm.html not required",
    "source_conflicts": "same-appearance disagreement (cell, membership, counter vs games-to-date, result, jumper) = SOURCE_CONFLICT, blocks PASS; printed multi-appearance figure vs composed reference = SOURCE_DERIVED_INCONSISTENCY (non-blocking) only when contributing cells are double-sourced, else aggregate unresolved"
  },
