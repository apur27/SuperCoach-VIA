{
  "$defs": {
    "ArticleSummary": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "As Of"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "editorial_state": {
          "enum": [
            "published_archive",
            "generated",
            "draft"
          ],
          "title": "Editorial State",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "original_path": {
          "title": "Original Path",
          "type": "string"
        },
        "published": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "scope": {
          "enum": [
            "frozen",
            "live",
            "archive"
          ],
          "title": "Scope",
          "type": "string"
        },
        "slug": {
          "title": "Slug",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "slug",
        "title",
        "category",
        "published",
        "as_of",
        "scope",
        "excerpt",
        "editorial_state",
        "original_path",
        "resource"
      ],
      "title": "ArticleSummary",
      "type": "object"
    },
    "Freshness": {
      "additionalProperties": false,
      "properties": {
        "coverage_through": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "source-derived label, e.g. '2026 Grand Final'",
          "title": "Coverage Through"
        },
        "dataset_status": {
          "enum": [
            "legacy_unverified",
            "verified",
            "partial",
            "demo"
          ],
          "title": "Dataset Status",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "latest_completed_match_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "UTC instant if the local start time and venue zone are known",
          "title": "Latest Completed Match At"
        },
        "latest_completed_match_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Completed Match Date"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "season_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "null when the source does not declare it",
          "title": "Season Active"
        },
        "source_checked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Checked At"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "stale_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        },
        "validation_state": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ],
          "title": "Validation State",
          "type": "string"
        }
      },
      "required": [
        "source_checked_at",
        "latest_completed_match_at",
        "latest_completed_match_date",
        "coverage_through",
        "generated_at",
        "published_at",
        "validation_state",
        "dataset_status",
        "season_active",
        "stale"
      ],
      "title": "Freshness",
      "type": "object"
    },
    "LeaderRow": {
