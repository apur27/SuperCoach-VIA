  "$id": "https://supercoach-via.local/schemas/v1/accuracy_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_headline": {
      "anyOf": [
        {
          "$ref": "#/$defs/MetricBlock"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Baseline Id"
    },
    "cohorts": {
      "items": {
        "$ref": "#/$defs/CohortMetric"
      },
      "title": "Cohorts",
      "type": "array"
    },
    "headline": {
      "$ref": "#/$defs/MetricBlock"
    },
    "interval": {
      "$ref": "#/$defs/IntervalInfo"
    },
    "interval_coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interval Coverage"
    },
    "interval_median_width": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interval Median Width"
    },
    "label": {
      "title": "Label",
      "type": "string"
    },
    "mean_of_rounds_mae": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mean Of Rounds Mae"
    },
    "model_id": {
      "title": "Model Id",
      "type": "string"
    },
    "notes": {
      "items": {
        "type": "string"
      },
      "title": "Notes",
      "type": "array"
    },
    "origin": {
      "enum": [
        "prospective",
        "replay",
        "legacy_unknown"
      ],
      "title": "Origin",
      "type": "string"
    },
    "populations": {
      "$ref": "#/$defs/Populations"
    },
    "promotion": {
      "title": "Promotion",
      "type": "string"
    },
    "rows_resource": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "download key for the scored rows CSV",
      "title": "Rows Resource"
    },
    "season": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Season"
    }
  },
  "required": [
    "model_id",
    "baseline_id",
    "season",
    "origin",
    "label",
    "headline",
    "baseline_headline",
    "mean_of_rounds_mae",
    "populations",
    "cohorts",
    "interval",
    "interval_coverage",
    "interval_median_width",
    "promotion",
    "notes",
    "rows_resource"
  ],
  "title": "AccuracyReport",
  "type": "object",
  "x-public-schema-version": 1
}
