          "title": "Median Ae"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "rmse": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rmse"
