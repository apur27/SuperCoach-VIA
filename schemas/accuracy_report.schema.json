{
  "$defs": {
    "CohortMetric": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricBlock"
            },
            {
              "type": "null"
            }
          ]
        },
        "cohort": {
          "title": "Cohort",
          "type": "string"
        },
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/MetricBlock"
        },
        "sufficient": {
          "title": "Sufficient",
          "type": "boolean"
        }
      },
      "required": [
        "dimension",
        "cohort",
        "model",
        "baseline",
        "sufficient"
      ],
      "title": "CohortMetric",
      "type": "object"
    },
    "IntervalInfo": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "calibrated": {
          "title": "Calibrated",
          "type": "boolean"
        },
        "level": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Level"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Method"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
