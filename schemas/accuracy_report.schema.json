      "title": "MetricBlock",
      "type": "object"
    },
    "Populations": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "title": "Excluded",
          "type": "integer"
        },
        "exclusion_reasons": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Exclusion Reasons",
          "type": "object"
        },
        "intended": {
          "title": "Intended",
          "type": "integer"
        },
        "joined": {
          "title": "Joined",
          "type": "integer"
        },
        "missing": {
          "title": "Missing",
          "type": "integer"
        },
        "played": {
          "title": "Played",
          "type": "integer"
        },
        "predicted": {
          "title": "Predicted",
          "type": "integer"
