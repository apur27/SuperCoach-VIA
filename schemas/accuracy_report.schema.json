      "type": "object"
    },
    "MetricBlock": {
      "additionalProperties": false,
      "properties": {
        "bias": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bias"
        },
        "mae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mae"
        },
        "median_ae": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
