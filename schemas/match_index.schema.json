{
  "$defs": {
    "MatchSummary": {
      "additionalProperties": false,
      "properties": {
        "away": {
          "$ref": "#/$defs/TeamScore"
        },
        "date_precision": {
          "enum": [
            "minute",
            "day",
            "unknown"
          ],
          "title": "Date Precision",
          "type": "string"
        },
        "home": {
          "$ref": "#/$defs/TeamScore"
        },
        "local_start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "local wall time as sourced, 'YYYY-MM-DD HH:MM'",
          "title": "Local Start"
        },
        "match_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Match Date"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "replay_occurrence": {
          "title": "Replay Occurrence",
          "type": "integer"
        },
        "round_number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Round Number"
        },
        "season": {
          "title": "Season",
          "type": "integer"
        },
        "stage_id": {
          "title": "Stage Id",
          "type": "string"
        },
        "stage_label": {
          "title": "Stage Label",
          "type": "string"
        },
        "stage_order": {
          "title": "Stage Order",
          "type": "integer"
        },
        "stage_type": {
          "enum": [
            "regular",
            "final",
            "other"
          ],
          "title": "Stage Type",
          "type": "string"
        },
        "status": {
          "enum": [
            "scheduled",
            "in_progress",
            "complete",
            "postponed",
            "cancelled",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Venue"
        },
        "winner_club_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "null for draws, incomplete or unknown",
          "title": "Winner Club Id"
        }
      },
      "required": [
        "match_id",
        "season",
        "stage_id",
        "stage_label",
        "stage_type",
        "round_number",
        "stage_order",
        "replay_occurrence",
        "local_start",
        "match_date",
        "date_precision",
        "status",
        "venue",
        "home",
        "away",
        "winner_club_id"
      ],
      "title": "MatchSummary",
      "type": "object"
    },
    "TeamScore": {
      "additionalProperties": false,
      "properties": {
        "behinds": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Behinds"
        },
        "club_id": {
          "title": "Club Id",
          "type": "string"
        },
        "goals": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Goals"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        }
      },
      "required": [
        "club_id",
        "name",
        "goals",
        "behinds",
        "score"
      ],
      "title": "TeamScore",
      "type": "object"
    }
  },
  "$id": "https://supercoach-via.local/schemas/v1/match_index.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "matches": {
      "items": {
        "$ref": "#/$defs/MatchSummary"
      },
      "title": "Matches",
      "type": "array"
    },
    "season": {
      "title": "Season",
      "type": "integer"
    }
  },
  "required": [
    "season",
    "matches"
  ],
  "title": "MatchIndex",
  "type": "object",
  "x-public-schema-version": 1
}
