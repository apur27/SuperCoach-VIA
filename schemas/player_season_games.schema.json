{
  "$defs": {
    "PlayerGameColumns": {
      "additionalProperties": false,
      "description": "A season game log as parallel arrays (one entry per game; ``game_rows`` restores rows).",
      "properties": {
        "career_game_counter": {
          "items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Career Game Counter",
          "type": "array"
        },
        "club_id": {
          "items": {
            "type": "string"
          },
          "title": "Club Id",
          "type": "array"
        },
        "date_quality": {
          "items": {
            "enum": [
              "fixture_verified",
              "source",
              "inferred",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Date Quality",
          "type": "array"
        },
        "match_date": {
          "items": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Match Date",
          "type": "array"
        },
        "match_id": {
          "items": {
            "type": "string"
          },
          "title": "Match Id",
          "type": "array"
        },
        "opponent_club_id": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Opponent Club Id",
          "type": "array"
        },
        "opponent_name": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Opponent Name",
          "type": "array"
        },
        "result": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Result",
          "type": "array"
        },
        "stage_label": {
          "items": {
            "type": "string"
          },
          "title": "Stage Label",
          "type": "array"
        },
        "stats": {
          "description": "per game, positional values aligned to stat_columns",
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Stats",
          "type": "array"
        }
      },
      "required": [
        "match_id",
        "match_date",
        "date_quality",
        "stage_label",
        "club_id",
        "opponent_club_id",
        "opponent_name",
        "result",
        "career_game_counter",
        "stats"
      ],
      "title": "PlayerGameColumns",
      "type": "object"
    }
  },
  "$id": "https://supercoach-via.local/schemas/v1/player_season_games.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "games": {
      "$ref": "#/$defs/PlayerGameColumns"
    },
    "player_id": {
      "title": "Player Id",
      "type": "string"
    },
    "season": {
      "title": "Season",
      "type": "integer"
    },
    "stat_columns": {
      "description": "stats observed at least once in this file, in canonical order",
      "items": {
        "type": "string"
      },
      "title": "Stat Columns",
      "type": "array"
    }
  },
  "required": [
    "player_id",
    "season",
    "stat_columns",
    "games"
  ],
  "title": "PlayerSeasonGames",
  "type": "object",
  "x-public-schema-version": 1
}
