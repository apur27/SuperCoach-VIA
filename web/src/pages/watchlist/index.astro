---
import AppLayout from '../../layouts/AppLayout.astro';
import WatchlistView from '../../islands/WatchlistView';
import { manifest, readResource } from '../../lib/release-server';
import { withBase } from '../../lib/ids';
import { findDownload } from '../../lib/downloads';
const base = import.meta.env.BASE_URL;
const rel = manifest();
const dl = findDownload(readResource('downloads', 'downloads.json'), 'players_csv', 'csv');
const downloadHref = dl ? withBase(base, `data/${rel.release_id}/${dl.path}`) : withBase(base, 'downloads/');
---
<AppLayout title="Watchlist" description="Your locally saved players with current form and forecast; import and export as JSON." current="watchlist">
  <h1>Watchlist</h1>
  <WatchlistView client:load downloadHref={downloadHref} />
</AppLayout>
