---
import AppLayout from '../../layouts/AppLayout.astro';
import CompareView from '../../islands/CompareView';
import { manifest, readResource } from '../../lib/release-server';
import { withBase } from '../../lib/ids';
import { findDownload } from '../../lib/downloads';
const base = import.meta.env.BASE_URL;
const rel = manifest();
const dl = findDownload(readResource('downloads', 'downloads.json'), 'players_csv', 'csv');
const downloadHref = dl ? withBase(base, `data/${rel.release_id}/${dl.path}`) : withBase(base, 'downloads/');
---
<AppLayout title="Compare players" description="Compare up to four players on common statistics with coverage and era warnings." current="players" breadcrumbs={[{ label: 'Players', href: 'players/' }, { label: 'Compare' }]}>
  <h1 id="page-h1">Compare players</h1>
  <CompareView client:load downloadHref={downloadHref} />
</AppLayout>
