---
import AppLayout from '../../layouts/AppLayout.astro';
import PlayerSearch from '../../islands/PlayerSearch';
import { manifest, readResource } from '../../lib/release-server';
import { withBase } from '../../lib/ids';
import { findDownload } from '../../lib/downloads';
const base = import.meta.env.BASE_URL;
const rel = manifest();
const dl = findDownload(readResource('downloads', 'downloads.json'), 'players_csv', 'csv');
const downloadHref = dl ? withBase(base, `data/${rel.release_id}/${dl.path}`) : withBase(base, 'downloads/');
---
<AppLayout title="Players" description="Search every player in the release history by name, club, season and status." current="players">
  <h1>Players</h1>
  <p class="lede">Search the full player history. Players who share a name are told apart by clubs and seasons.</p>
  <PlayerSearch client:load downloadHref={downloadHref} />
</AppLayout>
