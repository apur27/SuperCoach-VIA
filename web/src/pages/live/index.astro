---
import AppLayout from '../../layouts/AppLayout.astro';
import LiveView from '../../islands/LiveView';
import { readResource } from '../../lib/release-server';
import { withBase } from '../../lib/ids';
const idx = readResource('live_index', 'live/index.json');
const base = import.meta.env.BASE_URL;
---
<AppLayout title="Match snapshots" description="Captured match snapshots from this release. They do not update in place." current="matches" breadcrumbs={[{ label: 'Matches', href: 'matches/' }, { label: 'Snapshots' }]}>
  <h1 id="page-h1">Match snapshots</h1>
  <p class="muted">{idx.delivery} These are archived captures from the release. Opening this page does not poll a live feed.</p>
  <LiveView client:load index={idx} downloadHref={withBase(base, 'downloads/')} />
</AppLayout>
