---
import type { Freshness } from '../lib/contracts';
import Instant from './Instant.astro';
import { withBase } from '../lib/ids';
interface Props { freshness: Freshness; season: number; demo: boolean; releaseId: string }
const { freshness: f, season, demo, releaseId } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class="context" data-testid="freshness" aria-label="Release freshness">
  <div class="wrap">
    <dl>
      <div><dt>Season</dt><dd>{season}{demo && <span class="badge badge-demo">DEMO</span>}</dd></div>
      <div><dt>Coverage through</dt><dd>{f.coverage_through ?? <span class="missing">not recorded</span>}</dd></div>
      <div><dt>Freshness at build</dt><dd>{f.stale ? <span class="badge badge-stale">Stale</span> : <span class="badge badge-ok">Current</span>}</dd></div>
      <div><dt class="visually-hidden">Source &amp; method</dt><dd><a href={withBase(base, 'data-status/')}>Data status</a> · <a href={withBase(base, 'methodology/')}>Methodology</a></dd></div>
    </dl>
    <details class="context-more">
      <summary>Release details</summary>
      <p>Snapshot selection records whether this build used the locally selected dataset. See Data status for source audit findings.</p>
      <dl>
        <div><dt>Snapshot selection</dt><dd>{f.validation_state}</dd></div>
        <div><dt>Source checked</dt><dd><Instant iso={f.source_checked_at} /></dd></div>
        <div><dt>Generated</dt><dd><Instant iso={f.generated_at} /></dd></div>
        <div><dt>Published</dt><dd>{f.published_at ? <Instant iso={f.published_at} /> : <span class="missing">not recorded in release</span>}</dd></div>
        <div><dt>Release</dt><dd><code>{releaseId}</code></dd></div>
      </dl>
    </details>
    {f.stale && (
      <div class="banner banner-stale" role="status" data-testid="stale-banner">
        <p><strong>Data may be out of date.</strong> {f.stale_reason ?? 'The source has not been confirmed recently.'}</p>
      </div>
    )}
  </div>
</section>
