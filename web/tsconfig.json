{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "scripts/**/*.d.ts", "*.config.ts"],
  "exclude": ["dist", "node_modules", "test-results", ".e2e-dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],
    "noPropertyAccessFromIndexSignature": false
  }
}
